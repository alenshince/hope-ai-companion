# Server Configuration
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# LLM Providers Configuration
# Supported providers: gemini (primary), openai, claude, offline
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_FLASH_MODEL=gemini-2.0-flash
GEMINI_PRO_MODEL=gemini-1.5-pro

# Optional alternative providers
OPENAI_API_KEY=
OPENAI_FLASH_MODEL=gpt-4o-mini
OPENAI_PRO_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Text-to-Speech (TTS) Configuration
# Supported: edge (Microsoft Edge neural TTS), browser (Web Speech API)
TTS_PROVIDER=edge
TTS_FEMALE_VOICE_ML=ml-IN-SobhanaNeural
TTS_FEMALE_VOICE_EN=en-IN-NeerjaNeural

# Authentication & Security
JWT_SECRET=replace_this_with_a_secure_random_64_char_string_for_production
# 32-byte hex key for AES-256-GCM at-rest encryption of sensitive health data
HEALTH_DATA_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

